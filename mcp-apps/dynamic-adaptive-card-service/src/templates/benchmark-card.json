{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "emphasis",
      "bleed": true,
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "📊",
                  "size": "Large"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${metricName}",
                  "weight": "Bolder",
                  "size": "Medium",
                  "wrap": true
                },
                {
                  "type": "TextBlock",
                  "text": "Peer Cohort: ${cohortName} • ${observationPeriod}",
                  "isSubtle": true,
                  "size": "Small"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${percentileBadge}",
                  "weight": "Bolder",
                  "color": "Good",
                  "size": "Small"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "separator": true,
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "INTERNAL VALUE",
              "size": "Small",
              "isSubtle": true,
              "weight": "Bolder"
            },
            {
              "type": "TextBlock",
              "text": "${internalValue}",
              "size": "Large",
              "weight": "Bolder",
              "color": "Accent"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "PEER MEDIAN (P50)",
              "size": "Small",
              "isSubtle": true,
              "weight": "Bolder"
            },
            {
              "type": "TextBlock",
              "text": "${peerMedian}",
              "size": "Large",
              "weight": "Bolder"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "TOP QUARTILE (P75)",
              "size": "Small",
              "isSubtle": true,
              "weight": "Bolder"
            },
            {
              "type": "TextBlock",
              "text": "${topQuartile}",
              "size": "Large",
              "weight": "Bolder",
              "color": "Good"
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "id": "methodologyDetails",
      "isVisible": false,
      "separator": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "📐 Normalization Methodology & Sample Governance",
          "weight": "Bolder"
        },
        {
          "type": "FactSet",
          "facts": [
            {
              "title": "Sample Size",
              "value": "${sampleSize} Regional Carriers"
            },
            {
              "title": "Currency Basis",
              "value": "AED (Normalized at 3.6725 USD/AED)"
            },
            {
              "title": "Confidence Score",
              "value": "${confidenceScore}"
            },
            {
              "title": "Licensed Source",
              "value": "${licensedSource}"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Verified Dataset Version: ${datasetVersion} • Refresh SLA: Monthly",
      "isSubtle": true,
      "size": "Small",
      "separator": true
    }
  ],
  "actions": [
    {
      "type": "Action.ToggleVisibility",
      "title": "Methodology & Sources",
      "targetElements": [
        "methodologyDetails"
      ]
    },
    {
      "type": "Action.Execute",
      "title": "Download Comparative Dataset",
      "verb": "BENCHMARK_EXPORT_DATASET",
      "data": {
        "action": "BENCHMARK_EXPORT_DATASET",
        "metricId": "${metricId}"
      }
    }
  ]
}
