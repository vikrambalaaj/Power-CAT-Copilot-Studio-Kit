{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "emphasis",
      "bleed": true,
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "⚖️",
                  "size": "Large"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${decisionTitle}",
                  "weight": "Bolder",
                  "size": "Medium",
                  "wrap": true
                },
                {
                  "type": "TextBlock",
                  "text": "Decision ID: ${decisionId} • ${evaluatedDate}",
                  "isSubtle": true,
                  "size": "Small"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${decisionOutcome}",
                  "weight": "Bolder",
                  "color": "Good",
                  "size": "Small"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "separator": true,
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "STRATEGIC ALIGNMENT",
              "size": "Small",
              "isSubtle": true,
              "weight": "Bolder"
            },
            {
              "type": "TextBlock",
              "text": "${scoreStrategic}/100",
              "size": "Large",
              "weight": "Bolder",
              "color": "Accent"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "FISCAL IMPACT",
              "size": "Small",
              "isSubtle": true,
              "weight": "Bolder"
            },
            {
              "type": "TextBlock",
              "text": "${scoreFiscal}/100",
              "size": "Large",
              "weight": "Bolder",
              "color": "Good"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "PEER BENCHMARK",
              "size": "Small",
              "isSubtle": true,
              "weight": "Bolder"
            },
            {
              "type": "TextBlock",
              "text": "${scorePeer}/100",
              "size": "Large",
              "weight": "Bolder",
              "color": "Warning"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "HISTORICAL PRECEDENT",
              "size": "Small",
              "isSubtle": true,
              "weight": "Bolder"
            },
            {
              "type": "TextBlock",
              "text": "${scoreHistorical}/100",
              "size": "Large",
              "weight": "Bolder"
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "id": "decisionRationalePanel",
      "isVisible": false,
      "separator": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "📜 Auditable Rationale & Precedent Analysis",
          "weight": "Bolder"
        },
        {
          "type": "TextBlock",
          "text": "${rationaleSummary}",
          "wrap": true,
          "size": "Small"
        },
        {
          "type": "FactSet",
          "facts": [
            {
              "title": "Comparable Precedent",
              "value": "${comparablePrecedent}"
            },
            {
              "title": "Identified Risks",
              "value": "${identifiedRisks}"
            },
            {
              "title": "Questions to Probe",
              "value": "${openQuestions}"
            },
            {
              "title": "Confidence Rating",
              "value": "${confidenceRating}"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Dataverse Audit Ref: ${auditRef} • SHA-256 Merkle Hash: ${merkleRoot}",
      "isSubtle": true,
      "size": "Small",
      "separator": true
    }
  ],
  "actions": [
    {
      "type": "Action.ToggleVisibility",
      "title": "Why this result?",
      "targetElements": [
        "decisionRationalePanel"
      ]
    },
    {
      "type": "Action.Execute",
      "title": "Export Audit Manifest (JSON)",
      "verb": "AUDIT_EXPORT_MANIFEST",
      "data": {
        "action": "AUDIT_EXPORT_MANIFEST",
        "decisionId": "${decisionId}"
      }
    }
  ]
}
