{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "emphasis",
      "bleed": true,
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "⚡",
                  "size": "Large"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${cardTitle}",
                  "weight": "Bolder",
                  "size": "Medium",
                  "wrap": true
                },
                {
                  "type": "TextBlock",
                  "text": "${asOfDate} • ${userPrincipal}",
                  "isSubtle": true,
                  "size": "Small"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${urgencyLevel}",
                  "weight": "Bolder",
                  "color": "Attention",
                  "size": "Small"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "separator": true,
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "OVERDUE / URGENT",
              "size": "Small",
              "isSubtle": true,
              "weight": "Bolder"
            },
            {
              "type": "TextBlock",
              "text": "${urgentCount} Items",
              "size": "Large",
              "weight": "Bolder",
              "color": "Attention"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "PENDING APPROVALS",
              "size": "Small",
              "isSubtle": true,
              "weight": "Bolder"
            },
            {
              "type": "TextBlock",
              "text": "${pendingApprovalsCount} Items",
              "size": "Large",
              "weight": "Bolder",
              "color": "Warning"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "FINANCIAL EXPOSURE",
              "size": "Small",
              "isSubtle": true,
              "weight": "Bolder"
            },
            {
              "type": "TextBlock",
              "text": "${financialExposure}",
              "size": "Large",
              "weight": "Bolder",
              "color": "Accent"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "High Priority Deliverables & Action Items",
      "weight": "Bolder",
      "separator": true
    },
    {
      "type": "Container",
      "$data": "${items}",
      "separator": true,
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${title}",
                  "weight": "Bolder",
                  "wrap": true
                },
                {
                  "type": "TextBlock",
                  "text": "${details}",
                  "size": "Small",
                  "isSubtle": true,
                  "wrap": true
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${dueLabel}",
                  "size": "Small",
                  "weight": "Bolder",
                  "color": "Attention"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Source: M365 Mail & Planner • S/4HANA Open Line Items",
      "isSubtle": true,
      "size": "Small",
      "separator": true
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "Review Full Triage Queue",
      "verb": "TRIAGE_OPEN_QUEUE",
      "data": {
        "action": "TRIAGE_OPEN_QUEUE",
        "sessionId": "${sessionId}"
      }
    },
    {
      "type": "Action.Execute",
      "title": "Acknowledge All",
      "verb": "TRIAGE_ACKNOWLEDGE_ALL",
      "data": {
        "action": "TRIAGE_ACKNOWLEDGE_ALL",
        "sessionId": "${sessionId}"
      }
    }
  ]
}
