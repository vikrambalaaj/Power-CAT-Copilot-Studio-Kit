{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "emphasis",
      "bleed": true,
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "🤖",
                  "size": "Large"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${recommendationTitle}",
                  "weight": "Bolder",
                  "size": "Medium",
                  "wrap": true
                },
                {
                  "type": "TextBlock",
                  "text": "Autonomous KPI Scan • ${reportingPeriod}",
                  "isSubtle": true,
                  "size": "Small"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${categoryBadge}",
                  "weight": "Bolder",
                  "color": "Attention",
                  "size": "Small"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "separator": true,
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "ACTUAL / OBSERVED",
              "size": "Small",
              "isSubtle": true,
              "weight": "Bolder"
            },
            {
              "type": "TextBlock",
              "text": "${actualValue}",
              "size": "Medium",
              "weight": "Bolder"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "BENCHMARK / TARGET",
              "size": "Small",
              "isSubtle": true,
              "weight": "Bolder"
            },
            {
              "type": "TextBlock",
              "text": "${targetValue}",
              "size": "Medium",
              "weight": "Bolder"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "FINANCIAL IMPACT",
              "size": "Small",
              "isSubtle": true,
              "weight": "Bolder"
            },
            {
              "type": "TextBlock",
              "text": "${financialImpact}",
              "size": "Medium",
              "weight": "Bolder",
              "color": "Attention"
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "style": "default",
      "separator": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "💡 Prescribed Executive Action",
          "weight": "Bolder"
        },
        {
          "type": "TextBlock",
          "text": "${prescribedAction}",
          "wrap": true,
          "size": "Small"
        }
      ]
    },
    {
      "type": "Container",
      "id": "underlyingDriversPanel",
      "isVisible": false,
      "separator": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "🔍 Auditable Reasoning Chain & Underlying Drivers",
          "weight": "Bolder"
        },
        {
          "type": "FactSet",
          "facts": [
            {
              "title": "Step 1: ERP Trigger",
              "value": "${reasoningStep1}"
            },
            {
              "title": "Step 2: Policy Rule",
              "value": "${reasoningStep2}"
            },
            {
              "title": "Step 3: Quantified Impact",
              "value": "${reasoningStep3}"
            },
            {
              "title": "Step 4: Prescribed Intervention",
              "value": "${reasoningStep4}"
            }
          ]
        },
        {
          "type": "TextBlock",
          "text": "Confidence Level: ${confidenceScore} • Evidence: ${evidenceQuality}",
          "size": "Small",
          "weight": "Bolder",
          "color": "Good"
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Source: ${sourceCitation} • Governed Write: Confirmation required before execution.",
      "isSubtle": true,
      "size": "Small",
      "separator": true
    }
  ],
  "actions": [
    {
      "type": "Action.ToggleVisibility",
      "title": "Why this recommendation?",
      "targetElements": [
        "underlyingDriversPanel"
      ]
    },
    {
      "type": "Action.Execute",
      "title": "👍 Helpful",
      "verb": "FEEDBACK_SUBMIT",
      "data": {
        "action": "FEEDBACK_SUBMIT",
        "rating": "HELPFUL",
        "alertId": "${alertId}",
        "category": "${categoryBadge}"
      }
    },
    {
      "type": "Action.Execute",
      "title": "👎 Not Helpful",
      "verb": "FEEDBACK_SUBMIT",
      "data": {
        "action": "FEEDBACK_SUBMIT",
        "rating": "NOT_HELPFUL",
        "alertId": "${alertId}",
        "category": "${categoryBadge}"
      }
    }
  ]
}
