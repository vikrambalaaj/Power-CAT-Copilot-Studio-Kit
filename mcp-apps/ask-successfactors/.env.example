SF_API_URL=https://api.successfactors.com/odata/v2
SF_COMPANY_ID=your-company-id
SF_USERNAME=your-api-user
SF_PASSWORD=use-a-secret-store
SF_EMIRATI_FILTER=customString10 eq 'Emirati'
SF_EMIRATISATION_TARGET=40
PORT=8082
MCP_API_KEY=generate-a-long-random-secret
ALLOW_ANONYMOUS=false
ALLOWED_HOSTS=localhost:*,127.0.0.1:*,your-mcp-host.example.com
ALLOWED_ORIGINS=
CORS_ORIGINS=
ENABLE_MUTATING_TOOLS=false
ENABLE_WIDGET=false
MCP_FILE_LOG=false
LOG_LEVEL=INFO
CACHE_ENABLED=true
CACHE_TTL_SECONDS=120
CACHE_MAX_ENTRIES=512
