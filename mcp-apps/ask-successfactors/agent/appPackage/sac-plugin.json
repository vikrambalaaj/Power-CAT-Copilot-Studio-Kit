{
    "$schema": "https://developer.microsoft.com/json-schemas/copilot/plugin/v2.4/schema.json",
    "schema_version": "v2.4",
    "name_for_human": "Velora SAC",
    "description_for_human": "Delivers executive financial, KPI, and BI story insights from SAP Analytics Cloud.",
    "description_for_model": "Query enterprise KPIs, executive performance dashboards, and analytical models live from SAP Analytics Cloud (SAC).",
    "namespace": "sac",
    "functions": [
        {
            "name": "get_sac_kpis",
            "description": "Retrieve executive financial, operational, and strategic KPIs from SAP Analytics Cloud (SAC).",
            "capabilities": {
                "response_semantics": {
                    "data_path": "$",
                    "properties": {
                        "title": "$.cardTitle",
                        "subtitle": "$.cardSubtitle",
                        "template_selector": "$.adaptiveCard"
                    },
                    "static_template": {
                        "file": "adaptive-cards/executive-brief.json"
                    }
                }
            },
            "parameters": {
                "type": "object",
                "properties": {
                    "domain": {
                        "type": "string",
                        "description": "Domain of interest (e.g. FINANCE, OPERATIONS, WORKFORCE, STRATEGY). Default is FINANCE."
                    }
                }
            },
            "states": {
                "reasoning": {
                    "description": "Identifying strategic domain performance indicators..."
                },
                "executing": {
                    "description": "[SAP Analytics Cloud MCP] Retrieving corporate EBITDA and operating margins..."
                },
                "responding": {
                    "description": "Synthesizing corporate metrics and rendering Executive Performance Card..."
                }
            }
        },
        {
            "name": "get_sac_story_analytics",
            "description": "Fetch high-level business intelligence story insights, charts, and variances from SAP Analytics Cloud.",
            "capabilities": {
                "response_semantics": {
                    "data_path": "$",
                    "properties": {
                        "title": "$.cardTitle",
                        "subtitle": "$.cardSubtitle",
                        "template_selector": "$.adaptiveCard"
                    },
                    "static_template": {
                        "file": "adaptive-cards/executive-brief.json"
                    }
                }
            },
            "parameters": {
                "type": "object",
                "properties": {
                    "story_id": {
                        "type": "string",
                        "description": "Identifier of the SAC Story (e.g. VELORA_CORP_PERF_2026)."
                    }
                }
            },
            "states": {
                "reasoning": {
                    "description": "Loading SAC Story BI dimensions and variance drivers..."
                },
                "executing": {
                    "description": "[SAP Analytics Cloud MCP] Retrieving verified SAC Story analytics and commentary..."
                },
                "responding": {
                    "description": "Rendering Strategic Story Analytics Card..."
                }
            }
        },
        {
            "name": "get_sac_model_data",
            "description": "Query data export model structures and aggregated metric values directly from SAP Analytics Cloud models.",
            "capabilities": {
                "response_semantics": {
                    "data_path": "$",
                    "properties": {
                        "title": "$.cardTitle",
                        "subtitle": "$.cardSubtitle",
                        "template_selector": "$.adaptiveCard"
                    },
                    "static_template": {
                        "file": "adaptive-cards/sap-result.json"
                    }
                }
            },
            "parameters": {
                "type": "object",
                "properties": {
                    "model_id": {
                        "type": "string",
                        "description": "Model ID in SAP Analytics Cloud."
                    },
                    "measures": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "List of measure field names to query."
                    }
                },
                "required": [
                    "model_id"
                ]
            },
            "states": {
                "reasoning": {
                    "description": "Resolving SAC analytical model ID and requested measures..."
                },
                "executing": {
                    "description": "[SAP Analytics Cloud MCP] Querying raw measure datasets from model..."
                },
                "responding": {
                    "description": "Formatting analytical model data table..."
                }
            }
        }
    ],
    "runtimes": [
        {
            "type": "RemoteMCPServer",
            "spec": {
                "url": "https://sac-analytics-mcp-server.cfapps.eu10-005.hana.ondemand.com/mcp",
                "mcp_tool_description": {
                    "tools": [
                        {
                            "name": "get_sac_kpis",
                            "description": "Retrieve executive financial, operational, and strategic KPIs from SAP Analytics Cloud (SAC).",
                            "inputSchema": {
                                "type": "object",
                                "properties": {
                                    "domain": {
                                        "type": "string",
                                        "description": "Domain of interest (e.g. FINANCE, OPERATIONS, WORKFORCE, STRATEGY). Default is FINANCE."
                                    }
                                }
                            }
                        },
                        {
                            "name": "get_sac_story_analytics",
                            "description": "Fetch high-level business intelligence story insights, charts, and variances from SAP Analytics Cloud.",
                            "inputSchema": {
                                "type": "object",
                                "properties": {
                                    "story_id": {
                                        "type": "string",
                                        "description": "Identifier of the SAC Story (e.g. VELORA_CORP_PERF_2026)."
                                    }
                                }
                            }
                        },
                        {
                            "name": "get_sac_model_data",
                            "description": "Query data export model structures and aggregated metric values directly from SAP Analytics Cloud models.",
                            "inputSchema": {
                                "type": "object",
                                "properties": {
                                    "model_id": {
                                        "type": "string",
                                        "description": "Model ID in SAP Analytics Cloud."
                                    },
                                    "measures": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        },
                                        "description": "List of measure field names to query."
                                    }
                                },
                                "required": [
                                    "model_id"
                                ]
                            }
                        }
                    ]
                }
            },
            "run_for_functions": [
                "get_sac_kpis",
                "get_sac_story_analytics",
                "get_sac_model_data"
            ],
            "auth": {
                "type": "None"
            }
        }
    ]
}
