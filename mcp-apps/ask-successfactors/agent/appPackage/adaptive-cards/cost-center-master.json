{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {"type": "TextBlock", "text": "Cost Center Master Data", "weight": "Bolder", "size": "Medium"},
    {"type": "TextBlock", "text": "SAP S/4HANA · permission-trimmed", "isSubtle": true},
    {"type": "FactSet", "facts": [
      {"title": "Records", "value": "${formatNumber(data.total, 0)}"},
      {"title": "Controlling Area", "value": "${if(query.filters.ControllingArea, query.filters.ControllingArea, '1000')}"},
      {"title": "Company Code", "value": "${if(query.filters.CompanyCode, query.filters.CompanyCode, '1000')}"}
    ]},
    {"type": "TextBlock", "text": "Copilot summarizes cost center hierarchy, responsible manager, validity dates, and profit center assignments.", "wrap": true, "size": "Small", "isSubtle": true}
  ]
}
