{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "emphasis",
      "bleed": true,
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "⚖️",
                  "size": "Large"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Executive Decision & Audit Trace",
                  "weight": "Bolder",
                  "size": "Medium"
                },
                {
                  "type": "TextBlock",
                  "text": "${decisionTitle}",
                  "wrap": true,
                  "size": "Small",
                  "isSubtle": true
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${confidenceBadge}",
                  "weight": "Bolder",
                  "color": "Good",
                  "size": "Small"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "FactSet",
      "facts": [
        {"title": "Decision Owner", "value": "${owner}"},
        {"title": "Evaluation Date", "value": "${decisionDate}"},
        {"title": "Alignment Score", "value": "${alignmentScore}/100"},
        {"title": "Fiscal Impact", "value": "${fiscalImpact}"},
        {"title": "Correlation ID", "value": "${correlationId}"},
        {"title": "Verified Sources", "value": "${evidenceCount} sources (100% match)"}
      ]
    },
    {
      "type": "Container",
      "id": "reasoningChainPanel",
      "isVisible": false,
      "separator": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "🔍 Auditable Reasoning Chain & Precedent Analysis",
          "weight": "Bolder"
        },
        {
          "type": "TextBlock",
          "text": "${rationaleSummary}",
          "wrap": true,
          "size": "Small"
        },
        {
          "type": "FactSet",
          "facts": [
            {"title": "Strategic Priority", "value": "${strategicRule}"},
            {"title": "Fiscal Calculation", "value": "${fiscalCalculation}"},
            {"title": "Precedent Case", "value": "${precedentCase}"},
            {"title": "Identified Caveats", "value": "${governanceCaveats}"}
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Dataverse Log: ${auditLogRef} • Rule Version: ${ruleVersion}",
      "size": "Small",
      "isSubtle": true,
      "separator": true
    }
  ],
  "actions": [
    {
      "type": "Action.ToggleVisibility",
      "title": "Why this result?",
      "targetElements": [
        "reasoningChainPanel"
      ]
    },
    {
      "type": "Action.Execute",
      "title": "Export Audit Manifest (JSON)",
      "verb": "AUDIT_EXPORT_MANIFEST",
      "data": {
        "action": "AUDIT_EXPORT_MANIFEST",
        "decisionId": "${decisionId}"
      }
    }
  ]
}
