S4_API_URL=https://your-s4-host.example.com/sap/opu/odata/sap
S4_AUTH_MODE=oauth
S4_TOKEN_URL=https://your-identity-provider.example.com/oauth/token
S4_CLIENT_ID=your-client-id
S4_CLIENT_SECRET=use-a-secret-store
S4_USERNAME=
S4_PASSWORD=
S4_AR_ENTITY=ZVELORA_AR_AGING_SRV/ReceivablesAgingSet
S4_AP_ENTITY=ZVELORA_AP_AGING_SRV/PayablesAgingSet
S4_PL_ENTITY=ZVELORA_PL_SRV/ProfitAndLossSet
S4_BUDGET_ENTITY=ZVELORA_BUDGET_SRV/BudgetVarianceSet
PORT=8083
MCP_API_KEY=generate-a-long-random-secret
ALLOW_ANONYMOUS=false
ALLOWED_HOSTS=localhost:*,127.0.0.1:*,your-s4-mcp-host.example.com
ALLOWED_ORIGINS=
CORS_ORIGINS=
LOG_LEVEL=INFO
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
CACHE_MAX_ENTRIES=512
OAUTH_TOKEN_CACHE_SKEW_SECONDS=30
