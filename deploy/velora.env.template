# ==============================================================================
# Velora Executive AI Platform - Environment Configuration Template
# PRODUCTION HARDENED CONFIGURATION (NO REAL SECRETS IN TEMPLATE)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Identity Boundary & Microsoft Entra Configuration (Section 2)
# ------------------------------------------------------------------------------
# Mandatory Entra Directory / Tenant ID for token verification (fail closed if omitted)
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Strict separation between Inbound MCP API audience and outbound resource audiences
ENTRA_INBOUND_AUDIENCE=api://velora-copilot-mcp
GRAPH_RESOURCE_AUDIENCE=https://graph.microsoft.com
DATAVERSE_RESOURCE_AUDIENCE=https://velora-prod.crm.dynamics.com

# Zero-trust Gateway Assertion / EasyAuth Configuration
# Set to 1 only behind a trusted reverse proxy that strips client-injected headers
# In production without an authenticating gateway, direct bearer token validation is enforced.
TRUST_EASYAUTH_PRINCIPAL=0
STRICT_AUTH_GATEWAY=1

# ------------------------------------------------------------------------------
# 2. Durable Operation Store & Approval Replay Protection (Section 3)
# ------------------------------------------------------------------------------
# Shared SQLite WAL database or Azure Files mount path for atomic state machine
VELORA_STATE_DIR=/mnt/velora/state
VELORA_OPERATION_DB=/mnt/velora/state/operations.db
APPROVAL_TOKEN_SECRET=changeme_in_production_keyvault_secret
POLICY_VERSION=2026.1

# ------------------------------------------------------------------------------
# 3. Facilitator Write Protection & Memory Store (Section 4)
# ------------------------------------------------------------------------------
FACILITATOR_STORAGE_DIR=/mnt/velora/facilitator
ALLOWED_RECIPIENT_DOMAINS=velora.ae,veloragroup.com
ADMIN_ROLES=Velora_Admin,GlobalAdmin

# ------------------------------------------------------------------------------
# 4. Dataverse Audit Durability Contract (Section 5)
# ------------------------------------------------------------------------------
DATAVERSE_BASE_URL=https://velora-prod.crm.dynamics.com
DATAVERSE_CLIENT_ID=00000000-0000-0000-0000-000000000000
DATAVERSE_CLIENT_SECRET=secretref:velora-dataverse-secret
# Strict fail-closed policy: Governed writes are blocked unless Dataverse confirms COMMITTED or ALREADY_COMMITTED
STRICT_FAIL_CLOSED_AUDIT=1
SF_SPOOL_FILE_PATH=/mnt/velora/sf/sf_audit_spool.jsonl

# ------------------------------------------------------------------------------
# 5. SAP S/4HANA Finance Integration (Section 6)
# ------------------------------------------------------------------------------
S4_AUTH_MODE=basic
S4_USERNAME=API_USER
S4_PASSWORD=secretref:s4-password
S4_API_URL=https://fiori.velora.ae/sap/opu/odata4/sap/zfi_sbn_ageingdata_srv/srvd_a2x/sap/zfi_sdf_ageingdata_srv/0001
S4_VERIFY_TLS=true
# P&L is strictly excluded from production S/4HANA endpoints (returns UNSUPPORTED_OPERATION)
# Budget consumption mapping configuration is required before activating budget endpoints
BUDGET_MAPPING_CONFIGURED=false

# ------------------------------------------------------------------------------
# 6. Notification Claims & Reconciliation (Section 7)
# ------------------------------------------------------------------------------
VELORA_OUTBOX_DIR=/mnt/velora/outbox
VELORA_OUTBOX_DB=/mnt/velora/outbox/outbox.db
REQUIRE_LIVE_DELIVERY=false
RUN_PERIODIC_OUTBOX_SWEEP=true
LEASE_DURATION_SECONDS=30.0

# ------------------------------------------------------------------------------
# 7. Network Perimeter & Ingress Security
# ------------------------------------------------------------------------------
ALLOWED_HOSTS=fiori.velora.ae,api22.sapsf.com,teams.microsoft.com,copilotstudio.microsoft.com,*.azurecontainerapps.io,localhost
CORS_ORIGINS=https://teams.microsoft.com,https://copilotstudio.microsoft.com,https://fiori.velora.ae
ALLOW_ANONYMOUS=false
